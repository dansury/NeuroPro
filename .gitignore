# Runtime data (SQLite DB, logs, uploads, watch inbox) — never committed.
# Каталог данных живёт НАД веб-корнем: локально это data/ в корне репозитория
# (cfg_data_root() в www/lib/config.php); www/data — крайний fallback.
data/
www/data/

# Local env / secrets (.env лежит рядом с data/ — над веб-корнем)
.env
www/.env

# OS / editor
.DS_Store
*.swp
node_modules/

# Grafify knowledge graph output (build locally with /graphify .)
graphify-out/
