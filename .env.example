# 4neuropro — environment variables.
#
# КУДА КЛАСТЬ .env: над веб-корнем, рядом с каталогом data/.
#   Локально:    корень репозитория (веб-корень — www/) → ./.env
#   На хостинге: каталог НАД корнем сайта (pull.php зеркалит www/ в корень
#                сайта; .env туда не деплоится и не отдаётся веб-сервером).
#   Явный путь:  переменная окружения NP_ENV_FILE=/path/to/.env.
# Файл читает cfg_load_env_file() в www/lib/config.php; реальные переменные
# окружения процесса имеют приоритет над файлом.
#
# Resolution order per key: settings DB row (setup.php) > ENV > .env file > config.php default.
# You can configure everything via setup.php instead of ENV.

# ── LLM provider ──
LLM_PROVIDER=yandex                # yandex (по умолчанию) | openrouter
LLM_PROVIDER_PRIORITY=yandex,openrouter
LLM_DEFAULT_MODEL=yandexgpt        # short id from AVAILABLE_MODELS (config.php)
# Каталог AVAILABLE_MODELS общий: Yandex AI Studio (свои + открытые модели) и
# OpenRouter (OpenAI, Anthropic, Google, Meta, DeepSeek, Qwen, Mistral, xAI, …).
# Что реально доступно ключу — кнопки «Проверить каталог» в setup.php.
# Запасные модели: пробуются (у всех провайдеров) после выбранной модели.
LLM_FALLBACK_MODELS=yandexgpt-lite,deepseek-v3

# ── OpenRouter ──
OPENROUTER_API_KEY=
LLM_VISION_MODEL=google/gemini-2.0-flash-001
LLM_FALLBACK_MODEL=openrouter/auto
LLM_OCR_MODELS=google/gemini-2.5-flash,google/gemini-2.0-flash-001

# ── Yandex Cloud (LLM + Vision OCR) ──
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_FALLBACK_MODEL=yandexgpt    # первопартийная модель есть в любом каталоге
YANDEX_OCR_MODEL=page
YANDEX_OCR_ENABLED=1

# ── Mail (defaults target Yandex SMTP) ──
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=you@yandex.ru
SMTP_PASS=
SMTP_FROM=you@yandex.ru
SMTP_FROM_NAME=4neuropro
ADMIN_EMAIL=admin@example.com
ERROR_EMAIL=

# ── Admin gate for setup.php ──
# Не обязателен здесь: если .env положить на хостинг нельзя, оставьте пусто и
# задайте пароль при ПЕРВОМ ЗАПУСКЕ прямо в setup.php — он сохранится в БД
# (каталог data/ над веб-корнем) и переживёт деплой.
ADMIN_PASSWORD=

# ── Storage ──
DB_PATH=
LOG_DIR=

# ── Watch-folder daemon ──
# Папка, за которой следит bin/watch.php (новый .xls → профиль).
WATCH_DIR=
# URL приложения анализа: watcher открывает его в браузере при новом файле.
# Пусто — авто-открытие выключено.
APP_URL=http://neuropro.skywood.club/app/

# ── Матрица показателей ──
# Пороги уровней (в % от максимума шкалы) и полоса медианы (в % от предела шкалы
# физиологии). От них зависит не только картинка, но и раздел отчёта, в который
# попадёт шкала. Обычно их двигают мышью прямо на матрице или в setup.php —
# тогда значения хранятся в БД и .env не нужен.
MATRIX_LOW_PCT=40
MATRIX_HIGH_PCT=60
MATRIX_MID_BAND_PCT=5
# Мультипликатор размера кружка: радиус ∝ вес^POWER (1 — линейно, больше — контрастнее).
MATRIX_SIZE_POWER=2
